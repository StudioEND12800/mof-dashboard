# ──────────────────────────────────────────────────────────────
# EXEMPLE de fichier secrets.toml pour Streamlit Community Cloud
# ──────────────────────────────────────────────────────────────
# Sur Streamlit Cloud :
#   1. Ouvrir l'app → ⋮ > Settings > Secrets
#   2. Coller le contenu ci-dessous en remplaçant la valeur
#
# En local : copier ce fichier en .streamlit/secrets.toml
# (il est dans .gitignore et ne sera jamais commis)
# ──────────────────────────────────────────────────────────────

password = "votre-mot-de-passe-secret"
